        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  subgraph S1[\&quot;Programa principal\&quot;]\n    P0([\&quot;Inicio\&quot;])\n    P1[\&quot;Crear el arreglo puntos vacío e inicializar i = 0\&quot;]\n    P2{\&quot;i &amp;lt; 10?\&quot;}\n    P3[/\&quot;Ingresar X e Y del punto i + 1\&quot;/]\n    P4[\&quot;Guardar puntos[i] = [X, Y]\&quot;]\n    P5[\&quot;i = i + 1\&quot;]\n    P6[[\&quot;Llamar a generarMatrizDistancias(puntos) y guardar el resultado en matrizDistancias\&quot;]]\n    P7[/\&quot;Mostrar los puntos ingresados usando document.write\&quot;/]\n    P8[/\&quot;Mostrar las filas de matrizDistancias usando document.write\&quot;/]\n    P9([\&quot;Fin\&quot;])\n    P0 --&gt; P1\n    P1 --&gt; P2\n    P2 --&gt;|Sí| P3\n    P3 --&gt; P4\n    P4 --&gt; P5\n    P5 -.-&gt;|regreso| P2\n    P2 --&gt;|No| P6\n    P6 --&gt; P7\n    P7 --&gt; P8\n    P8 --&gt; P9\n  end\n\n  subgraph S2[\&quot;Función generarMatrizDistancias\&quot;]\n    G0([\&quot;Inicio de la función\&quot;])\n    G1[\&quot;Crear distancias vacía e inicializar i = 0\&quot;]\n    G2{\&quot;i &amp;lt; cantidad de puntos?\&quot;}\n    G3[\&quot;Crear distancias[i] e inicializar j = 0\&quot;]\n    G4{\&quot;j &amp;lt; cantidad de puntos?\&quot;}\n    G5{\&quot;i === j?\&quot;}\n    G6[\&quot;Guardar 0 en distancias[i][j]\&quot;]\n    G7[[\&quot;Llamar a calcularDistancia con las coordenadas de puntos[i] y puntos[j]\&quot;]]\n    G8[\&quot;Guardar el resultado en distancias[i][j]\&quot;]\n    G9[\&quot;j = j + 1\&quot;]\n    G10[\&quot;i = i + 1\&quot;]\n    G11[/\&quot;Retornar distancias\&quot;/]\n    G12([\&quot;Fin de la función\&quot;])\n    G0 --&gt; G1\n    G1 --&gt; G2\n    G2 --&gt;|Sí| G3\n    G3 --&gt; G4\n    G4 --&gt;|Sí| G5\n    G5 --&gt;|Sí| G6\n    G5 --&gt;|No| G7\n    G7 --&gt; G8\n    G6 --&gt; G9\n    G8 --&gt; G9\n    G9 -.-&gt;|regreso| G4\n    G4 --&gt;|No| G10\n    G10 -.-&gt;|regreso| G2\n    G2 --&gt;|No| G11\n    G11 --&gt; G12\n  end\n\n  subgraph S3[\&quot;Función calcularDistancia\&quot;]\n    H0([\&quot;Inicio de la función\&quot;])\n    H1[/\&quot;Recibir x1, y1, x2, y2\&quot;/]\n    H2[\&quot;diferenciaX = x2 - x1\&quot;]\n    H3[\&quot;diferenciaY = y2 - y1\&quot;]\n    H4[\&quot;distancia = raíz cuadrada de diferenciaX² + diferenciaY²\&quot;]\n    H5[/\&quot;Retornar distancia\&quot;/]\n    H6([\&quot;Fin de la función\&quot;])\n    H0 --&gt; H1\n    H1 --&gt; H2\n    H2 --&gt; H3\n    H3 --&gt; H4\n    H4 --&gt; H5\n    H5 --&gt; H6\n  end\n\n  P6 -.-&gt;|llama| G0\n  G7 -.-&gt;|llama cuando i ≠ j| H0&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="68">
